{
  "manifest_version": 3,
  "name": "OpenLanguageToolClient",
  "version": "1.0.1",
  "description": "Underlines the mistakes a LanguageTool server reports in the compose window.",
  "homepage_url": "https://gitlab.com/iglou.eu/openlanguagetoolclient",
  "icons": {
    "16": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "openlanguagetoolclient@iglou.eu",
      "strict_min_version": "153.0"
    }
  },
  "permissions": [
    "compose",
    "menus",
    "messengerSettings",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background/background.js"
    ],
    "type": "module"
  },
  "commands": {
    "list-mistakes": {
      "suggested_key": {
        "default": "Ctrl+Alt+M"
      },
      "description": "List the mistakes in this message"
    },
    "check-now": {
      "suggested_key": {
        "default": "Ctrl+Alt+S"
      },
      "description": "Check this message now, without waiting for the pause"
    }
  },
  "compose_action": {
    "default_title": "LanguageTool",
    "default_icon": "icons/icon.svg",
    "type": "menu"
  },
  "compose_scripts": [
    {
      "css": [
        "compose/compose.css"
      ],
      "js": [
        "compose/body-text.js",
        "compose/scheduler.js",
        "compose/panel.js",
        "compose/compose.js"
      ]
    }
  ],
  "options_ui": {
    "page": "options/options.html"
  }
}
